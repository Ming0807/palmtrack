# Local development only. Copy to .env.local and provide local Supabase values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only administrative credential. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only database connections. Use DIRECT_URL for migrations/backup tooling.
DATABASE_URL=
DIRECT_URL=
